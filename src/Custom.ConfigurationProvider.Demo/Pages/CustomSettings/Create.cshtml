@page
@model Custom.Configuration.Provider.Demo.Pages.CustomSettings.CreateModel
@{ViewData["Title"] = "Create";
}
<h4>New configuration</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="AppSettingsCustom.CustomSettingA" class="form-label">CustomSettingA</label>
                <input asp-for="AppSettingsCustom.CustomSettingA" class="form-control" />
                <span asp-validation-for="AppSettingsCustom.CustomSettingA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AppSettingsCustom.CustomSettingB" class="form-label">CustomSettingB</label>
                <input asp-for="AppSettingsCustom.CustomSettingB" class="form-control" />
                <span asp-validation-for="AppSettingsCustom.CustomSettingB" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="AppSettingsCustom.Default" class="form-check-input" />
                <label asp-for="AppSettingsCustom.Default" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-page="Index">Back to List</a>
</div>
