@page
@model Custom.Configuration.Provider.Demo.Pages.CustomSettings.DeleteModel
@{ViewData["Title"] = "Delete";
}

<h4>Do you want to delete configuration?</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">CustomSettingA</label>
                <input asp-for="AppSettingsCustom.CustomSettingA" class="form-control" readonly="readonly" />
            </div>

            <div class="mb-3">
                <label class="form-label">CustomSettingB</label>
                <input asp-for="AppSettingsCustom.CustomSettingB" class="form-control" readonly="readonly" />
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="chkBoxDefaultDisabled" checked=@Model.AppSettingsCustom.Default disabled>
                <label class="form-check-label" for="chkBoxDefaultDisabled">@Html.DisplayNameFor(model => model.AppSettingsCustom.Default)</label>
            </div>
            <hr />
            <div class="mb-3">
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                <a asp-page="./Index">Back to List</a>
            </div>
        </form>
    </div>
</div>